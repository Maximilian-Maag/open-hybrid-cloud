# Example environment for the whole stack. The backend and frontend each read
# their own subset — see apps/backend/.env.example and apps/frontend/.env.example
# for the per-app files actually loaded in development.
#
# AI translation, branding and exchange-rate *settings* are configured at runtime
# in the admin UI (stored in the database), not via env vars.

# ── Database ──────────────────────────────────────────────────────────────────
# DB name must match infra/docker-compose*.yml (open_hybrid_cloud).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/open_hybrid_cloud

# ── Backend auth ──────────────────────────────────────────────────────────────
# HMAC signing key for session JWTs. Must be at least 32 characters — the app
# refuses to start otherwise.
JWT_SECRET=change-this-to-a-random-secret-min-32-chars

# Initial local admin account, seeded on first boot when no users exist.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# URL the backend redirects to after SSO login.
FRONTEND_URL=http://localhost:3000

# ── Session lifetime (issue #37) ──────────────────────────────────────────────
# Sessions are rows in the database and can be listed and revoked; the token
# names one. These are in SECONDS, and both are clamped to 30 days.
# Unset = 8 h for an ordinary login, 30 days for one with "remember me" ticked.
SESSION_TTL_SECONDS=
SESSION_REMEMBER_ME_TTL_SECONDS=

# Trust X-Forwarded-For from the reverse proxy. Set this ONLY when a proxy you
# control sets that header, because it decides two things: the per-IP login
# rate-limit bucket, and the address shown in a user's session list. Unset means
# no address is recorded at all, which is the honest answer without a proxy.
TRUST_PROXY=

# ── Microsoft Entra ID (OIDC) — optional ──────────────────────────────────────
# Leave blank for local development; the local admin account works without SSO.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Callback URL registered in Entra ID, e.g. https://your-domain/api/auth/callback
ENTRA_REDIRECT_URI=http://localhost:3001/api/auth/callback

# ── SMTP — optional (falls back to admin-UI config if unset) ───────────────────
# Local: Mailpit via `make dev` (Web UI: http://localhost:8026)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_FROM=noreply@open-hybrid-cloud.local
SMTP_USER=
SMTP_PASS=
SMTP_TLS=false

# ── Exchange rates — optional ─────────────────────────────────────────────────
EXCHANGE_RATE_API_URL=https://api.exchangerate.host/latest

# ── Scheduled decommissioning — optional ──────────────────────────────────────
# Shared secret for POST /api/internal/decommission-sweep, which tears down
# infrastructure whose scheduled decommission time has arrived.
#
# Leave BLANK to disable the feature's sweep: the endpoint then returns 503 rather
# than accepting anonymous calls. Scheduling a decommission in the UI still stores
# the time; nothing acts on it until a sweep runs.
#
# Set to 1 or true only when a proxy you control sets X-Forwarded-For. It gates
# the per-IP half of the login rate limiter; the per-account half always applies.
# Any client can forge the header, so leaving this unset is the safe default.
TRUST_PROXY=

# The sweep needs an external scheduler — the backend has no worker process, and
# it is horizontally scaled, so an in-process timer would run once per replica.
# The sweep is idempotent (its active -> decommissioning claim is atomic), so
# calling it more often than needed is harmless. Kubernetes: see
# decommissionSweep in infra/helm/open-hybrid-cloud/values.yaml. Plain cron:
#
#   */15 * * * * curl -fsS -X POST -H "X-Sweep-Secret: $DECOMMISSION_SWEEP_SECRET" \
#     http://localhost:3001/api/internal/decommission-sweep
#
DECOMMISSION_SWEEP_SECRET=

# ── External-system integrations — optional ───────────────────────────────────
# Key that encrypts the credentials in the integration registry (issue #111):
# Foreman, Ansible/AWX, Nexus, Pulp, Loki, Grafana. AES-256-GCM, so exactly 32
# bytes hex-encoded — 64 hex characters:
#
#   openssl rand -hex 32
#
# Leave BLANK to disable the feature: the admin endpoints then refuse any request
# carrying a credential with a 503 naming this variable. They deliberately do NOT
# fall back to storing the token in plain text, which is the state
# ci_sources.access_token is still in and the thing #111 exists to not repeat.
#
# TREAT THIS AS UNROTATABLE ONCE IN USE. There is no re-encryption path yet: a
# changed key cannot decrypt what the old one wrote, and every stored credential
# has to be re-entered. Back it up wherever JWT_SECRET is backed up.
SECRET_ENCRYPTION_KEY=

# ── Frontend ──────────────────────────────────────────────────────────────────
# API base URL. NEXT_PUBLIC_API_URL is inlined into the client bundle at build
# time; API_URL is used for server-side requests.
NEXT_PUBLIC_API_URL=http://localhost:3001
API_URL=http://localhost:3001
NEXTAUTH_URL=http://localhost:3000
# Secret for next-auth session encryption (min. 32 characters).
NEXTAUTH_SECRET=change-this-to-a-random-secret-min-32-chars

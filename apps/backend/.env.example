DATABASE_URL=postgresql://postgres:postgres@postgres:5432/open_hybrid_cloud
# At least 32 characters, or every login fails. Generate: openssl rand -base64 48
JWT_SECRET=change-this-to-a-random-secret-min-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme
# Encrypts the TOTP second-factor secrets at rest. 32 bytes, hex or base64:
#   openssl rand -base64 32
# Blank = derived from JWT_SECRET, which works but ties the two together:
# rotating JWT_SECRET then makes every enrolled authenticator unreadable.
TOTP_ENCRYPTION_KEY=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Callback URL registered in Entra ID (e.g. https://your-domain.example.com/api/auth/callback)
ENTRA_REDIRECT_URI=
FRONTEND_URL=http://localhost:3000
# Session lifetimes in seconds (issue #37); blank = 8 h, and 30 days with
# "remember me". Both are clamped to 30 days.
SESSION_TTL_SECONDS=
SESSION_REMEMBER_ME_TTL_SECONDS=
# Trust X-Forwarded-For. Only with a reverse proxy you control: it sets the
# per-IP login rate-limit bucket AND the address shown in the session list.
TRUST_PROXY=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@example.com
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true
EXCHANGE_RATE_API_URL=https://api.exchangerate.host/latest

# Enables POST /api/internal/decommission-sweep (see ../../.env.example).
# Blank = the sweep endpoint is disabled (503).
DECOMMISSION_SWEEP_SECRET=
# Enables the external-system integration registry (issue #111): Foreman,
# Ansible, Nexus, Pulp, Loki, Grafana. Their credentials are AES-256-GCM
# encrypted with this key. Exactly 64 hex characters: openssl rand -hex 32
# Blank = the registry refuses to store any credential (503).
SECRET_ENCRYPTION_KEY=

# ── Security keys / passkeys (issue #197) ─────────────────────────────────────
# WebAuthn is scoped to a Relying Party, and the browser signs the assertion over
# the origin it is actually on. Getting these wrong is the one failure that works
# perfectly on localhost and breaks every key on the deployed instance — the same
# shape as #196 — so the backend validates them the first time a WebAuthn
# ceremony runs (`resolveRp`) and refuses with a message naming the variable,
# rather than letting the browser fail silently later.
#
# Note WHEN: on first use, not at boot. A misconfigured instance starts, serves
# every other page, and only reports this when someone tries to register or use a
# key — so check it deliberately after a deploy rather than waiting to be told.
#
#   WEBAUTHN_RP_ID     a BARE DOMAIN. No scheme, no port, no path.
#                      portal.example.com — or example.com to let a credential
#                      work across subdomains.
#   WEBAUTHN_RP_ORIGIN the full origin the browser sees, WITH scheme and port.
#                      https://portal.example.com. Comma-separate several if the
#                      deployment answers on more than one hostname; the RP ID has
#                      to be a suffix of every one of them.
#
# Left blank they default to localhost, which is what makes a fresh clone work
# with a key straight away. Both are REQUIRED when NODE_ENV=production; the
# backend refuses to start a ceremony without them rather than issuing
# credentials nobody can use.
#
# Changing WEBAUTHN_RP_ID invalidates every registered credential — they are
# scoped to it. Moving the portal to a new domain means everyone re-registers
# their key, so pick the broadest domain you might want before anyone enrols.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_ORIGIN=

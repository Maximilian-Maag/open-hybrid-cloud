# Docker Hub username (used to pull images)
DOCKERHUB_USERNAME=your-dockerhub-username

# Image tag: dev | staging | latest (production)
IMAGE_TAG=latest

# ── Database ───────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password

# ── Frontend ───────────────────────────────────────────────────────────────────
# Public URL of the application (used by NextAuth)
NEXTAUTH_URL=https://your-domain.example.com
# Random secret for NextAuth JWT signing (min. 32 characters)
NEXTAUTH_SECRET=change-this-to-a-random-secret-min-32-chars

# ── Backend ────────────────────────────────────────────────────────────────────
# Random secret for backend JWT signing (min. 32 characters)
JWT_SECRET=change-this-to-a-random-secret-min-32-chars

# Encrypts the root account's TOTP second-factor secrets at rest (issue #36).
# 32 bytes, hex or base64:
#   openssl rand -base64 32
# Blank derives the key from JWT_SECRET, which works but ties the two together:
# rotating JWT_SECRET then makes every enrolled authenticator unreadable and
# forces a re-enrollment. Set it before anyone enrols in production.
TOTP_ENCRYPTION_KEY=

# Initial root admin account (only used on first startup when the DB is empty)
ADMIN_EMAIL=admin@your-domain.example.com
ADMIN_PASSWORD=change-me-strong-password

# Exchange rate API (used to fetch current currency conversion rates)
EXCHANGE_RATE_API_URL=https://api.exchangerate.host/latest

# ── Microsoft Entra ID / OIDC (optional) ──────────────────────────────────────
# Leave blank to disable SSO; only local accounts will work.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Callback URL registered in Entra ID (e.g. https://your-domain.example.com/api/auth/callback)
ENTRA_REDIRECT_URI=

# ── SMTP (optional) ────────────────────────────────────────────────────────────
# Leave blank to disable outgoing email.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=noreply@your-domain.example.com
SMTP_USER=
SMTP_PASS=
SMTP_TLS=true

# ── External-system integrations (optional) ───────────────────────────────────
# Encrypts the credentials of Foreman / Ansible / Nexus / Pulp / Loki / Grafana
# integrations. Exactly 64 hex characters: openssl rand -hex 32
# Leave blank to keep the feature off — it never falls back to plain text.
# Cannot be rotated once in use: a new key cannot decrypt what the old one wrote.
SECRET_ENCRYPTION_KEY=

# ── Security keys / passkeys (issue #197) ─────────────────────────────────────
# REQUIRED. Leaving these blank does not disable the feature — the button is
# still on the settings page, and pressing it answers 500. The backend validates
# them the first time a ceremony runs, not at boot, so a misconfigured instance
# starts normally and serves every other page.
#
# Both follow from NEXTAUTH_URL above:
#
#   NEXTAUTH_URL=https://portal.example.com
#   WEBAUTHN_RP_ID=portal.example.com          <- domain ONLY, no scheme, no port
#   WEBAUTHN_RP_ORIGIN=https://portal.example.com   <- full origin, WITH scheme
#
# Getting these wrong is the failure that works perfectly on localhost and
# breaks every key on the deployed instance. RP_ID must equal the page's domain
# or be a registrable suffix of it, or the browser refuses the ceremony outright.
# RP_ORIGIN must be exactly what the browser sends; a mismatch fails later, at
# verification. Several origins may be given comma-separated when one deployment
# answers on more than one hostname.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_ORIGIN=

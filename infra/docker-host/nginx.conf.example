# Reverse proxy for the single-Docker-host deployment.
#
#   cp nginx.conf.example nginx.conf
#   # edit the ONE line marked "CHANGE THIS" below
#   docker compose up -d --force-recreate nginx
#
# Nothing else in this file is site-specific: the upstreams are container names
# from docker-compose.yml and the certificate paths are the mount point defined
# there. If you change nothing but the domain, this file is complete.
#
# Do not simplify the /api routing. Both the frontend and the backend are
# Next.js applications and BOTH serve routes under /api; sending all of /api to
# the backend breaks sign-in with a 404 (#196). The ordering of the location
# blocks below is what keeps them apart, and it is load-bearing.

events {
    worker_connections 1024;
}

http {
    # Docker's embedded DNS. Needed so nginx re-resolves upstream hostnames
    # instead of caching the first IP forever — otherwise every Watchtower
    # auto-update leaves nginx pointing at the pre-restart IP and every request
    # returns 502 until nginx itself is restarted.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # HTTP → HTTPS redirect. Deliberately a catch-all: this is the only server
    # block on port 80, so nginx serves it for every Host header regardless of
    # what is written here, and the redirect preserves the host it was asked
    # for. Leaving it as `_` keeps the domain to a single place in this file.
    server {
        listen 80;
        server_name _;
        return 301 https://$host$request_uri;
    }

    # HTTPS
    server {
        # ─────────────────────────────────────────────────────────────────────
        # CHANGE THIS — your public domain, and the only edit this file needs.
        # It must match NEXTAUTH_URL in .env and the name on the certificate.
        # ─────────────────────────────────────────────────────────────────────
        server_name your-domain.example.com;

        listen 443 ssl;

        ssl_certificate     /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;

        ssl_protocols       TLSv1.2 TLSv1.3;
        ssl_ciphers         HIGH:!aNULL:!MD5;

        # Maximum upload size (for product images)
        client_max_body_size 10M;

        # Upstream hostnames are held in variables so nginx re-resolves them via
        # the Docker DNS on each request (see resolver directive above). Using
        # an `upstream {}` block or a bare hostname in proxy_pass would cache
        # the IP at start-up and break on container restart.
        set $frontend_upstream "frontend:3000";
        set $backend_upstream  "backend:3001";

        # There used to be an exact-match block here sending /api/auth/callback to
        # the backend, for Entra ID's OAuth callback. That flow was removed in
        # #139: nothing on the frontend ever consumed its result, and it handed
        # the session JWT back in a query string. When SSO is built properly the
        # block has to come back — an exact match, so it outranks the /api/auth/
        # block below, which would otherwise swallow the callback silently.

        # NextAuth.js's own routes (csrf, session, callback/credentials, signin,
        # signout, providers, ...) are served by the frontend, not the backend —
        # this must come before the general /api/ block below or login breaks.
        location /api/auth/ {
            proxy_pass         http://$frontend_upstream;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # Step one of a two-step sign-in is a FRONTEND route (#36), even though
        # it lives under /api. Missing it here is what broke the deployed
        # sign-in in #196: the general /api/ block below sent it to the backend,
        # which has no such route and answered 404.
        location = /api/login-challenge {
            proxy_pass         http://$frontend_upstream;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # The frontend's own liveness route, also under /api. The container
        # healthcheck reaches it directly on :3000 and so never noticed that
        # through this proxy it was answering from the backend.
        location = /api/ping {
            proxy_pass         http://$frontend_upstream;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # How the browser reaches the backend API (#146). A FRONTEND route: it
        # holds the session cookie, reads the bearer token from it server-side and
        # forwards the call, so the token is never in client JavaScript. Prefix,
        # not exact — the whole API surface hangs off it — and above the general
        # /api/ block, or every dashboard request goes to the backend and 404s.
        #
        # Note client_max_body_size above: a product picture now travels through
        # here rather than straight to the backend, so it is bounded twice.
        location /api/proxy/ {
            proxy_pass         http://$frontend_upstream;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # Backend API — proxied directly so browser-initiated requests work
        # (Next.js client components use relative /api/* URLs which land here)
        #
        # Anything the frontend serves under /api must be matched ABOVE this
        # block. apps/frontend/src/lib/apiRoutes.test.ts enumerates them from
        # the frontend build and fails if one is missing here.
        location /api/ {
            proxy_pass         http://$backend_upstream;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }

        # Frontend — all other traffic
        location / {
            proxy_pass         http://$frontend_upstream;
            proxy_http_version 1.1;
            proxy_set_header   Host              $host;
            proxy_set_header   X-Real-IP         $remote_addr;
            proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
            # Required for Next.js HMR (not used in production but harmless)
            proxy_set_header   Upgrade           $http_upgrade;
            proxy_set_header   Connection        "upgrade";
        }
    }
}

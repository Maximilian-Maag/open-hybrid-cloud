{
  "name": "GitLab pipeline status (project-scoped, as the API actually is)",
  "request": {
    "method": "GET",
    "urlPathPattern": "/api/v4/projects/[^/]+/pipelines/[0-9]+"
  },
  "response": {
    "status": 200,
    "jsonBody": { "id": 42, "status": "success", "ref": "main" },
    "headers": { "Content-Type": "application/json" }
  }
}
